PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_SSL=false
DB_USER=root
DB_PASSWORD=
DB_NAME=taskmate
SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
# Leave email provider values empty for local development; one-time codes print in the API terminal.
# Configure these values with your email provider for real email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Brevo HTTPS API settings (optional; preferred for Render Free).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TaskMate

